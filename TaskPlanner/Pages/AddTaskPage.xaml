<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskPlanner.Pages.AddTaskPage"
             Title="Dodaj Obavezu">
    <VerticalStackLayout Padding="20">
        <Entry x:Name="taskNameEntry" Placeholder="Naziv obaveze" />
        <Entry x:Name="taskDescriptionEntry" Placeholder="Opis obaveze" />
        <Button Text="Spremi" Clicked="OnSaveTaskClicked" BackgroundColor="#6D597A" TextColor="White"/>
    </VerticalStackLayout>
</ContentPage>
